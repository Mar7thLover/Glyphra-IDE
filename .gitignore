# deps / build
node_modules/
dist/
src-tauri/target/
src-tauri/gen/schemas/

# mobile icon derivatives from `tauri icon` (desktop-only app)
src-tauri/icons/android/
src-tauri/icons/ios/

# logs / caches
*.log
pnpm-debug.log*
.vite/
coverage/
.smoke/
.tmp/

# secrets — the updater signing key lives in ~/.tauri and must never be
# committed; losing it means never being able to publish an update again, and
# leaking it means anyone can sign one.
*.key
*.pem
*.p12
*.pfx
.env
.env.*
!.env.example

# editor / os
.DS_Store
Thumbs.db
*.local
.idea/
.vscode/
