  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "rb"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "rs"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "swift"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "kt"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "kts"
