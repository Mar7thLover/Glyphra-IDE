  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "tsv"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "json"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "jsonc"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "yaml"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "yml"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "toml"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "xml"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "ini"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "cfg"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "conf"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "env"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "properties"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "c"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "cc"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "cpp"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "cxx"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "h"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "hh"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "hpp"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "hxx"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "cs"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "css"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "scss"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "sass"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "less"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "go"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "java"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "js"
