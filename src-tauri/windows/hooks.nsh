  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "svelte"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "html"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "htm"
  !insertmacro UNREGISTER_GLYPHRA_TEXT_EXTENSION "php"
